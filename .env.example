# ============================================
# 英语学习平台 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================

# === 数据库 ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=english_platform
DB_USERNAME=root
DB_PASSWORD=your_db_password

# === JWT ===
JWT_SECRET=your_jwt_secret_key_at_least_32_characters

# === 通义千问 API (阿里云 DashScope) ===
TONGYI_API_KEY=your_tongyi_api_key

