<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.english.platform.mapper.UserKnowledgeStatMapper">
    <select id="selectWeakestKnowledge" resultType="com.english.platform.entity.UserKnowledgeStat">
        SELECT * FROM user_knowledge_stat
        WHERE user_id = #{userId}
        ORDER BY weak_score ASC
        LIMIT #{limit}
    </select>
</mapper>
